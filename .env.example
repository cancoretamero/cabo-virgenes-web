# Cabo Vírgenes — plantilla de entorno. Copia a .env y rellena valores reales.
# .env está git-ignored. NUNCA subir secretos reales.

# ── Claude (IA) ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── Admin (bootstrap owner) ─────────────────────────────────────────────────
CABO_ADMIN_USER=admin
CABO_ADMIN_TOKEN=pon-una-contraseña-fuerte
# Acceso de emergencia del panel (login admin / contraseña) si /api/auth no responde
CABO_ADMIN_PASS=cabovirgenes

# ── Perfiles del equipo (/api/auth) — contraseñas iniciales por entorno ──────
# La función auth.mjs siembra estos 4 perfiles en el primer arranque leyendo
# estas variables. NUNCA van en el código (repo público). Si cambias una tras
# el primer arranque, usa la acción reseed (token maestro) para re-sembrar.
CABO_PW_GABRIELA_A=cambia-esto
CABO_PW_JUANJOSE_R=cambia-esto
CABO_PW_CHANI_G=cambia-esto
CABO_PW_RTAMAGNINI=cambia-esto

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM="Cabo Vírgenes <noticias@cabovirgenes.com>"
RESEND_REPLY_TO="info@cabovirgenes.com"

# ── URL base ────────────────────────────────────────────────────────────────
APP_BASE_URL=https://cabovirgenes.com
